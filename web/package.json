{
  "name": "rocketsim-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "wasm": "../scripts/build-wasm.sh",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "canary": "node scripts/canary.mjs",
    "preview": "vite preview",
    "fixtures": "mkdir -p public/ephemeris && cp ../crates/sim-core/tests/fixtures/ephem_2026q4.rseph public/ephemeris/",
    "test:e2e": "playwright test",
    "models": "node ../tools/models/build_vehicle_glb.mjs ../data/vehicles/rs1_corvid.json public/models/rs1_corvid.glb"
  },
  "dependencies": {
    "3d-tiles-renderer": "0.5.3",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.1",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The game window may close itself (Quit) and toggle fullscreen (F11).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen"
  ]
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RocketSim",
  "version": "0.10.1",
  "identifier": "com.rocketsim.game",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../web"
    }
  },
  "app": {
    "windows": [
      {
        "title": "RocketSim",
        "width": 1600,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "label": "main",
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SimulationGame",
    "shortDescription": "Physics-first solar-system spaceflight",
    "copyright": "RocketSim contributors. Third-party data credits in the game's Credits screen.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
